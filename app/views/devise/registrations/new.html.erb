<div class="min-h-screen bg-gray-50 flex items-center justify-center py-12 px-4">
    <div class="max-w-md w-full bg-white rounded-lg shadow-md p-8">
      <h2 class="text-3xl font-bold text-center text-gray-800 mb-8">註冊帳號</h2>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <!-- 角色選擇 -->
        <div>
          <%= f.label :member_type, "選擇角色", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <div class="flex gap-4">
            <label class="flex-1 cursor-pointer">
              <div class="border-2 border-gray-300 rounded-lg p-4 hover:border-blue-500 transition">
                <%= f.radio_button :member_type, "customer", checked: true, class: "mr-2" %>
                <span class="font-medium">消費者</span>
                <p class="text-sm text-gray-500 mt-1">購買商品、管理票券</p>
              </div>
            </label>

            <label class="flex-1 cursor-pointer">
              <div class="border-2 border-gray-300 rounded-lg p-4 hover:border-blue-500 transition">
                <%= f.radio_button :member_type, "merchant", class: "mr-2" %>
                <span class="font-medium">商家</span>
                <p class="text-sm text-gray-500 mt-1">販售商品、管理訂單</p>
              </div>
            </label>
          </div>
        </div>

        <!-- Email -->
        <div>
          <%= f.label :email, "Email", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-3 border-2 border-gray-300 rounded-lg 
  focus:border-blue-500 focus:outline-none", placeholder: "your@email.com" %>
        </div>

        <!-- 密碼 -->
        <div>
          <%= f.label :password, "密碼", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <% if @minimum_password_length %>
            <span class="text-sm text-gray-500">(至少 <%= @minimum_password_length %> 個字元)</span>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password", class: "w-full px-4 py-3 border-2 border-gray-300 rounded-lg 
  focus:border-blue-500 focus:outline-none", placeholder: "輸入密碼" %>
        </div>

        <!-- 確認密碼 -->
        <div>
          <%= f.label :password_confirmation, "確認密碼", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-4 py-3 border-2 border-gray-300 
  rounded-lg focus:border-blue-500 focus:outline-none", placeholder: "再次輸入密碼" %>
        </div>

        <!-- 提交按鈕 -->
        <div>
          <%= f.submit "註冊", class: "w-full bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 font-semibold cursor-pointer" %>
        </div>
      <% end %>

      <!-- 其他連結 -->
      <div class="mt-6 text-center text-sm text-gray-600">
        <%= render "devise/shared/links" %>
      </div>
    </div>
</div>