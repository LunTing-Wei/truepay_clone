<div class="min-h-screen bg-gray-50 flex items-center justify-center py-12 px-4">
    <div class="max-w-md w-full bg-white rounded-lg shadow-md p-8">
      <h2 class="text-3xl font-bold text-center text-gray-800 mb-8">登入</h2>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
        <!-- 角色選擇 -->
        <div>
          <%= f.label :member_type, "登入身份", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <div class="flex gap-4">
            <label class="flex-1 cursor-pointer">
              <div class="border-2 border-gray-300 rounded-lg p-3 hover:border-blue-500 transition">
                <%= f.radio_button :member_type, "customer", checked: true, class: "mr-2" %>
                <span class="font-medium">消費者</span>
              </div>
            </label>

            <label class="flex-1 cursor-pointer">
              <div class="border-2 border-gray-300 rounded-lg p-3 hover:border-blue-500 transition">
                <%= f.radio_button :member_type, "merchant", class: "mr-2" %>
                <span class="font-medium">商家</span>
              </div>
            </label>
          </div>
        </div>

        <!-- Email -->
        <div>
          <%= f.label :email, "Email", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-3 border-2 border-gray-300 rounded-lg 
  focus:border-blue-500 focus:outline-none", placeholder: "your@email.com" %>
        </div>

        <!-- 密碼 -->
        <div>
          <%= f.label :password, "密碼", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "w-full px-4 py-3 border-2 border-gray-300 rounded-lg 
  focus:border-blue-500 focus:outline-none", placeholder: "輸入密碼" %>
        </div>

        <!-- 記住我 -->
        <% if devise_mapping.rememberable? %>
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "mr-2" %>
            <%= f.label :remember_me, "記住我", class: "text-sm text-gray-600" %>
          </div>
        <% end %>

        <!-- 提交按鈕 -->
        <div>
          <%= f.submit "登入", class: "w-full bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 font-semibold cursor-pointer" %>
        </div>
      <% end %>

      <!-- 其他連結 -->
      <div class="mt-6 text-center text-sm text-gray-600">
        <%= render "devise/shared/links" %>
      </div>
    </div>
</div>