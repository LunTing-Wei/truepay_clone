<div class="min-h-screen bg-gray-50">
    <div class="container mx-auto px-4 py-8 max-w-2xl">
      <h1 class="text-3xl font-bold text-gray-800 mb-8">訂單詳情</h1>

      <!-- 訂單資訊卡片 -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <!-- 訂單編號與狀態 -->
        <div class="flex justify-between items-center mb-6 pb-6 border-b">
          <div>
            <p class="text-sm text-gray-500 mb-1">訂單編號</p>
            <p class="text-xl font-bold text-gray-800">#<%= @order.id %></p>
          </div>

          <div>
            <% if @order.pending? %>
              <span class="px-4 py-2 bg-yellow-100 text-yellow-800 rounded-full text-sm font-semibold">
                等待付款
              </span>
            <% elsif @order.paid? %>
              <span class="px-4 py-2 bg-green-100 text-green-800 rounded-full text-sm font-semibold">
                已付款
              </span>
            <% end %>
          </div>
        </div>

        <!-- 商品資訊 -->
        <div class="mb-6">
          <h2 class="text-lg font-bold text-gray-800 mb-4">商品資訊</h2>

          <div class="bg-gray-50 rounded-lg p-4">
            <p class="text-xl font-bold text-gray-800 mb-2">
              <%= @order.product.name %>
            </p>

            <div class="flex justify-between items-center text-sm text-gray-600 mb-2">
              <span>單價</span>
              <span class="font-semibold text-gray-800">
                NT$ <%= @order.unit_price.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse %>
              </span>
            </div>

            <div class="flex justify-between items-center text-sm text-gray-600">
              <span>數量</span>
              <span class="font-semibold text-gray-800">
                <%= @order.quantity %> 張
              </span>
            </div>
          </div>
        </div>

        <!-- 總金額 -->
        <div class="pt-6 border-t">
          <div class="flex justify-between items-center">
            <span class="text-lg font-semibold text-gray-700">總金額</span>
            <span class="text-3xl font-bold text-green-600">
              NT$ <%= @order.amount.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse %>
            </span>
          </div>
        </div>
      </div>

      <!-- 按鈕區 -->
     <% if @order.pending? %>
          <!-- 付款選項 -->
          <div class="bg-white rounded-lg shadow-md p-6 mb-6">
            <h2 class="text-lg font-bold text-gray-800 mb-4">選擇付款方式</h2>

            <div class="space-y-3">
              <!-- LINE Pay 付款 -->
              <%= button_to linepay_request_order_path(@order), method: :post, data: { turbo: false }, class: "w-full bg-green-600 text-white px-6 py-4 rounded-lg hover:bg-green-700 font-semibold flex items-center justify-center gap-2 transition-colors" do %>
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 0H5C2.239 0 0 2.239 0 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5V5c0-2.761-2.238-5-5-5zm-3.732 
  17.621l-1.49-1.867h-3.022v1.867H9.021V6.379h4.39c1.726 0 3.148 1.421 3.148 3.147 0 1.254-.746 2.328-1.816 2.82l2.025 2.537c.427.537.427 
  1.287 0 1.738z"/>
                </svg>
                <span>LINE Pay 付款</span>
              <% end %>

              <!-- 測試付款（模擬） -->
              <%= button_to pay_order_path(@order), method: :post, data: { turbo: false }, class: "w-full bg-gray-600 text-white px-6 py-4 rounded-lg hover:bg-gray-700 font-semibold flex items-center justify-center gap-2 transition-colors" do %>
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
                <span>測試付款（開發用）</span>
              <% end %>
            </div>
          </div>
        <% else %>
          <!-- 已付款狀態 -->
          <div class="flex gap-4">
            <%= link_to "查看我的票券", tickets_path, class: "flex-1 bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 
  font-semibold text-center" %>
            <%= link_to "返回商店", store_path(@order.product.merchant), class: "flex-1 bg-gray-200 text-gray-700 px-6 py-3 rounded-lg 
  hover:bg-gray-300 font-semibold text-center" %>
          </div>
        <% end %>
    </div>
</div>