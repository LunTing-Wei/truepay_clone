<div class="min-h-screen bg-gray-50">
    <div class="container mx-auto px-4 py-8 max-w-2xl">
      <h1 class="text-3xl font-bold text-gray-800 mb-8">訂單詳情</h1>

      <!-- 訂單資訊卡片 -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <!-- 訂單編號與狀態 -->
        <div class="flex justify-between items-center mb-6 pb-6 border-b">
          <div>
            <p class="text-sm text-gray-500 mb-1">訂單編號</p>
            <p class="text-xl font-bold text-gray-800">#<%= @order.id %></p>
          </div>

          <div>
            <% if @order.pending? %>
              <span class="px-4 py-2 bg-yellow-100 text-yellow-800 rounded-full text-sm font-semibold">
                等待付款
              </span>
            <% elsif @order.paid? %>
              <span class="px-4 py-2 bg-green-100 text-green-800 rounded-full text-sm font-semibold">
                已付款
              </span>
            <% end %>
          </div>
        </div>

        <!-- 商品資訊 -->
        <div class="mb-6">
          <h2 class="text-lg font-bold text-gray-800 mb-4">商品資訊</h2>

          <div class="bg-gray-50 rounded-lg p-4">
            <p class="text-xl font-bold text-gray-800 mb-2">
              <%= @order.product.name %>
            </p>

            <div class="flex justify-between items-center text-sm text-gray-600 mb-2">
              <span>單價</span>
              <span class="font-semibold text-gray-800">
                NT$ <%= @order.unit_price.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse %>
              </span>
            </div>

            <div class="flex justify-between items-center text-sm text-gray-600">
              <span>數量</span>
              <span class="font-semibold text-gray-800">
                <%= @order.quantity %> 張
              </span>
            </div>
          </div>
        </div>

        <!-- 總金額 -->
        <div class="pt-6 border-t">
          <div class="flex justify-between items-center">
            <span class="text-lg font-semibold text-gray-700">總金額</span>
            <span class="text-3xl font-bold text-green-600">
              NT$ <%= @order.amount.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse %>
            </span>
          </div>
        </div>
      </div>

      <!-- 按鈕區 -->
      <div class="flex gap-4">
        <% if @order.pending? %>
          <%= button_to "模擬付款", pay_order_path(@order), method: :post, class: "flex-1 bg-green-600 text-white px-6 py-3 rounded-lg 
  hover:bg-green-700 font-semibold" %>
        <% else %>
          <%= link_to "查看我的票券", tickets_path, class: "flex-1 bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 
  font-semibold text-center" %>
        <% end %>

        <%= link_to "返回商店", store_path(@order.product.merchant), class: "flex-1 bg-gray-200 text-gray-700 px-6 py-3 rounded-lg 
  hover:bg-gray-300 font-semibold text-center" %>
      </div>
    </div>
</div>