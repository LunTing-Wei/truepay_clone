<div class="container mx-auto px-4 py-8 max-w-6xl">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl font-bold text-gray-800">商品管理</h1>
      <div class="flex gap-3">
      <%= link_to "查看商店", store_path(current_member.merchant),
          class: "bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 font-semibold" %>
      <%= link_to "新增商品", new_product_path,
          class: "bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 font-semibold" %>
    </div>
    </div>

    <% if @products&.any? %>
      <div class="grid gap-4">
        <% @products.each do |product| %>
          <div class="border-2 border-gray-200 rounded-lg p-6 bg-white shadow-sm hover:shadow-md transition">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <h2 class="text-xl font-bold text-gray-800 mb-2">
                  <%= product.name %>
                </h2>

                <div class="text-sm text-gray-600 mb-3">
                  商家：<span class="font-medium"><%= product.merchant.shop_name %></span>
                </div>

                <p class="text-gray-700 mb-4">
                  <%= product.description %>
                </p>

                <div class="flex items-center gap-6 text-sm">
                  <div>
                    <span class="text-gray-500">價格：</span>
                    <span class="text-lg font-bold text-green-600">NT$ <%= product.price %></span>
                  </div>

                  <div>
                    <span class="text-gray-500">庫存：</span>
                    <span class="font-semibold <%= product.stock > 0 ? 'text-green-600' : 'text-red-600' %>">
                      <%= product.stock %> 件
                    </span>
                  </div>

                  <div>
                    <span class="text-gray-500">狀態：</span>
                    <span class="px-2 py-1 rounded text-xs font-semibold <%= product.is_active ? 'bg-green-100 text-green-800' : 'bg-gray-100
   text-gray-800' %>">
                      <%= product.is_active ? '上架中' : '已下架' %>
                    </span>
                  </div>
                </div>
              </div>

              <div class="flex gap-2 ml-4">
                <%= link_to "編輯", edit_product_path(product), class: "px-4 py-2 bg-blue-100 text-blue-700 rounded hover:bg-blue-200 
  font-medium" %>
                <%= button_to "刪除", product_path(product), method: :delete,
                    data: { turbo_confirm: "確定要刪除這個商品嗎？" },
                    class: "px-4 py-2 bg-red-100 text-red-700 rounded hover:bg-red-200 font-medium" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16 bg-gray-50 rounded-lg border-2 border-dashed border-gray-300">
        <p class="text-gray-500 text-lg mb-4">目前沒有商品</p>
        <%= link_to "建立第一個商品", new_product_path, class: "text-blue-600 hover:text-blue-700 font-semibold" %>
      </div>
    <% end %>
</div>